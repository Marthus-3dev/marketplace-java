<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.marthus.marketplace.controller.MenuController">
   <left>
      <VBox prefHeight="600.0" prefWidth="160.0" styleClass="menu-inv-pag" stylesheets="@style.css" BorderPane.alignment="CENTER">
         <children>
            <Button alignment="TOP_LEFT" mnemonicParsing="false" prefHeight="30.0" prefWidth="160.0" styleClass="menu-inv-btn" stylesheets="@style.css" text="Visualizar Estoque">
               <graphic>
                  <FontIcon iconColor="#00bcf0" iconLiteral="mdi2a-archive-eye-outline" iconSize="24">
                     <styleClass>
                        <String fx:value="menu-inv-btn" />
                        <String fx:value="menu-icon-color" />
                     </styleClass></FontIcon>
               </graphic>
               <font>
                  <Font name="Trebuchet MS" size="12.0" />
               </font>
            </Button>
            <Button alignment="TOP_LEFT" mnemonicParsing="false" prefHeight="32.0" prefWidth="160.0" styleClass="menu-inv-btn" stylesheets="@style.css" text="Entrada de Produtos">
               <graphic>
                  <FontIcon iconLiteral="mdi2p-package-variant-closed-plus" iconSize="24">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                     <styleClass>
                        <String fx:value="menu-inv-btn" />
                        <String fx:value="menu-icon-color" />
                     </styleClass></FontIcon>
               </graphic>
               <font>
                  <Font name="Trebuchet MS" size="12.0" />
               </font>
            </Button>
            <Button alignment="TOP_LEFT" mnemonicParsing="false" prefHeight="32.0" prefWidth="160.0" styleClass="menu-inv-btn" stylesheets="@style.css" text="Relatórios">
               <graphic>
                  <FontIcon iconLiteral="mdi2c-clipboard-text-multiple-outline" iconSize="24">
                     <styleClass>
                        <String fx:value="menu-inv-btn" />
                        <String fx:value="menu-icon-color" />
                     </styleClass></FontIcon>
               </graphic>
               <font>
                  <Font name="Trebuchet MS" size="12.0" />
               </font>
            </Button>
            <Button fx:id="btnSair" alignment="TOP_LEFT" mnemonicParsing="false" onAction="#aoSair" prefHeight="32.0" prefWidth="160.0" styleClass="menu-inv-btn" stylesheets="@style.css" text="Sair do sistema">
               <font>
                  <Font name="Trebuchet MS Bold" size="11.0" />
               </font>
               <graphic>
                  <FontIcon iconLiteral="mdi2e-exit-run" iconSize="24">
                     <styleClass>
                        <String fx:value="menu-inv-btn" />
                        <String fx:value="menu-icon-color" />
                     </styleClass></FontIcon>
               </graphic>
            </Button>
         </children>
      </VBox>
   </left>
   <center>
      <VBox alignment="CENTER" prefHeight="600.0" prefWidth="600.0" styleClass="login-inv-pag" stylesheets="@style.css" BorderPane.alignment="CENTER">
         <children>
            <Label alignment="CENTER" contentDisplay="CENTER" styleClass="login-inv-pag" stylesheets="@style.css" text="Prepare-se para a minha chegada, estoque.">
               <font>
                  <Font name="Trebuchet MS Bold" size="18.0" />
               </font>
            </Label>
            <Label styleClass="login-inv-pag" stylesheets="@style.css" text="Selecione um botão ao lado" />
         </children></VBox>
   </center>
</BorderPane>
